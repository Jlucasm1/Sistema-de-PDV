<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Arquivos e pastas que existem passam direto
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo o resto vai para index.php
    RewriteRule ^ /index.php [QSA,L]
</IfModule>
