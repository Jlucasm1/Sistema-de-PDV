APP_ENV=local
APP_DISPLAY_ERRORS=true
TIMEZONE=America/Sao_Paulo
HTTPS=false
APPLICATION_NAME=PDV MASTER
HASH=pdvmaster@2024#secure_salt_key

# -----------------------------------------------
# Banco de Dados MySQL
# -----------------------------------------------
HOST_NAME=db
HOST_USERNAME=pdvmaster
HOST_PASSWORD=pdvmaster@2024
HOST_DBNAME=pdvmaster

# -----------------------------------------------
# Docker - Portas
# -----------------------------------------------
PORT_APP=8080
PORT_DB=3306
PORT_PMA=8081

# -----------------------------------------------
# MySQL (usado pelo Docker Compose)
# -----------------------------------------------
MYSQL_ROOT_PASSWORD=root@pdvmaster2024
MYSQL_DATABASE=pdvmaster
