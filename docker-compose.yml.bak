version: '3.8'

services:
  # -------------------------------------------------------
  # Serviço Web - PHP 8.1 + Apache
  # -------------------------------------------------------
  app:
    container_name: pdv_master_app
    build:
      context: ./.docker/web
      dockerfile: Dockerfile
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "${PORT_APP:-8080}:80"
    volumes:
      - .:/var/www/html
      - ./.docker/web/api.conf:/etc/apache2/sites-enabled/pdv-master.conf
    depends_on:
      db:
        condition: service_healthy
    networks:
      - pdv_network
    tty: true

  # -------------------------------------------------------
  # Serviço de Banco de Dados - MySQL 8.0
  # -------------------------------------------------------
  db:
    container_name: pdv_master_db
    image: mysql:8.0
    restart: unless-stopped
    ports:
      - "${PORT_DB:-3306}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      - pdv_db_data:/var/lib/mysql
      - ./.docker/db/init:/docker-entrypoint-initdb.d
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${MYSQL_ROOT_PASSWORD}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - pdv_network

  # -------------------------------------------------------
  # PHPMyAdmin - Administração visual do banco
  # -------------------------------------------------------
  phpmyadmin:
    container_name: pdv_master_pma
    image: phpmyadmin/phpmyadmin:latest
    restart: unless-stopped
    ports:
      - "${PORT_PMA:-8081}:80"
    environment:
      PMA_HOST: db
      PMA_USER: ${MYSQL_USER}
      PMA_PASSWORD: ${MYSQL_PASSWORD}
      UPLOAD_LIMIT: 300M
    depends_on:
      db:
        condition: service_healthy
    networks:
      - pdv_network

networks:
  pdv_network:
    driver: bridge

volumes:
  pdv_db_data:
    driver: local
