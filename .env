# 
# PDV MASTER — Arquivo de Configuração de Ambiente
# 

# Aplicação 
APP_ENV=local
APP_DISPLAY_ERRORS=true
APPLICATION_NAME="PDV MASTER"
TIMEZONE=America/Sao_Paulo
HTTPS=false

# Banco de Dados (conexão PHP → MySQL) 
HOST_NAME=pdv_master_db
HOST_USERNAME=pdvmaster
HOST_PASSWORD=pdvmaster@2024
HOST_DBNAME=pdvmaster

# MySQL (criação do banco no Docker) 
MYSQL_ROOT_PASSWORD=root@pdvmaster2024
MYSQL_DATABASE=pdvmaster
MYSQL_USER=pdvmaster
MYSQL_PASSWORD=pdvmaster@2024

# Portas dos containers 
PORT_APP=8080
PORT_PMA=8081

# Segurança 
HASH=PDVMaster@2024#SecretKey!xK9mZ

# E-mail (opcional) 
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Upload de imagens 
SHARED_HOST=false