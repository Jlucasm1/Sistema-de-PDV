{
    "name": "pdvmaster/pdvmaster",
    "description": "PDV MASTER - Sistema de Ponto de Venda",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "PDV MASTER Dev",
            "email": "dev@pdvmaster.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "System\\": "System/"
        },
        "files": [
            "System/Helpers/simpleHelpers.php",
            "System/Helpers/dateHelper.php",
            "System/Helpers/generateRandomCodigoDeBarras.php",
            "System/Helpers/codigoDeBarrasParaSvg.php"
        ]
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.0",
        "ext-pdo": "*",
        "ext-zip": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.5",
        "phpoffice/phpspreadsheet": "^1.28",
        "dompdf/dompdf": "^2.0",
        "phpmailer/phpmailer": "^6.8",
        "picqer/php-barcode-generator": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true
    }
}
